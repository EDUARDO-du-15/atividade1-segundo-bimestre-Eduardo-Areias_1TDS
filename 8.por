programa
{
	
	funcao inicio()
	{
		cadeia mae = "Tess", filha = "Anna", aux
		
		aux = mae
		mae = filha
		filha = aux

		escreva("A filha virou ", filha, " e a mãe virou ", mae)
	}
}
